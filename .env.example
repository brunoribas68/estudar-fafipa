# Copie este arquivo para .env (na raiz do projeto) e cole suas chaves de API.
# O .env (e o .env.local, usado pela CLI da ElevenLabs) nunca são commitados —
# ficam só na sua máquina (.gitignore já cobre os dois).

# ---- Gemini (tools/generate-audio.js) ----
GOOGLE_API_KEY=cole_sua_chave_aqui

# Voz do Gemini TTS (opcional — "Kore" já é um bom padrão, feminina e natural).
# Outras opções: Puck, Charon, Fenrir, Leda, Orus, Aoede, Autonoe, Callirrhoe...
GOOGLE_TTS_VOICE=Kore

# Modelo (opcional). "flash" é mais rápido/barato; "pro" tende a soar um pouco melhor.
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- ElevenLabs (tools/generate-audio-elevenlabs.js) ----
# Normalmente fica em .env.local (criado por `npx @elevenlabs/cli onboard init`),
# mas também funciona aqui no .env.
ELEVENLABS_API_KEY=cole_sua_chave_aqui

# ID da voz (opcional — o padrão é a "Rachel", multilíngue). Pra usar outra voz da
# sua conta, veja o ID em https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
