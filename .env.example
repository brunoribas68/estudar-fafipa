# Copie este arquivo para .env (na raiz do projeto) e cole sua chave de API do Google.
# O .env nunca é commitado (está no .gitignore) — fica só na sua máquina.

GOOGLE_API_KEY=cole_sua_chave_aqui

# Voz do Gemini TTS (opcional — "Kore" já é um bom padrão, feminina e natural).
# Outras opções: Puck, Charon, Fenrir, Leda, Orus, Aoede, Autonoe, Callirrhoe...
GOOGLE_TTS_VOICE=Kore

# Modelo (opcional). "flash" é mais rápido/barato; "pro" tende a soar um pouco melhor.
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
